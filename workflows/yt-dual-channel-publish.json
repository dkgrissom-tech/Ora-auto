      "main": [[
        { "node": "YT Upload: Finance", "type": "main", "index": 0 },
        { "node": "YT Upload: Military", "type": "main", "index": 0 }
      ]]
    },
    "YT Upload: Finance": { "main": [[{ "node": "Build Updated File", "type": "main", "index": 0 }]] },
    "YT Upload: Military": { "main": [[{ "node": "Build Updated File", "type": "main", "index": 0 }]] },
    "Build Updated File": { "main": [[{ "node": "GitHub: Mark Posted", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true, "saveDataErrorExecution": "all", "saveDataSuccessExecution": "all" },
