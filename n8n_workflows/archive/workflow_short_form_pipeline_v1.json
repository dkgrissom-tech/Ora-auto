                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "conditions": [{ "leftValue": "={{ $json.platform }}", "rightValue": "mailerlite", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true, "outputKey": "mailerlite"
            }
          ]
        },
        "options": { "fallbackOutput": "none" }
      }
