        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ repo: $('Bluesky Auth').item.json.did, collection: 'app.bsky.feed.post', record: { '$type': 'app.bsky.feed.post', text: $json.postText, createdAt: new Date().toISOString(), langs: ['en'] } }) }}",
        "options": {}
      },
