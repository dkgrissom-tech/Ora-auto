    {
      "parameters": {
        "jsCode": "// Fan out one item per brand draft folder.\n// FIX: the old draft directory does not exist in dkgrissom-tech/Ora-auto - the\n// real directory is clone_drafts/. The shop brand is not configured either.\nconst brands = ['ora', 'grissom', 'familybook'];\nreturn brands.map(brand => ({ json: { brand, path: `clone_drafts/${brand}` } }));"
      },
      "id": "node-brands",
      "name": "List Brand Folders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/dkgrissom-tech/Ora-auto/contents/{{ $json.path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.GITHUB_TOKEN || '') }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "User-Agent",
              "value": "ora-auto-n8n"
            }
          ]
        },
        "options": {}
      },
      "id": "node-list-files",
      "name": "List Draft Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// FIX: iterate every input item (was $input.first(), which dropped 3 of 4 brands).\n// FIX: derive brand from the file's own path instead of correlating to node output 0.\n// Tolerates a missing folder (GitHub returns {message:'Not Found'}) without throwing.\nconst out = [];\nfor (const item of $input.all()) {\n  const p = item.json;\n  let files = [];\n  if (Array.isArray(p)) files = p;\n  else if (Array.isArray(p.data)) files = p.data;\n  else if (p && p.name) files = [p];\n  for (const f of files) {\n    if (!f || typeof f.name !== 'string' || !f.path) continue;\n    if (!f.name.toLowerCase().endsWith('.md')) continue;\n    if (f.name.includes('.posted-')) continue;      // already published\n    if (f.name.includes('.skip.')) continue;        // manually retired\n    if (f.name.toLowerCase() === 'readme.md') continue;\n    if (f.type && f.type !== 'file') continue;   // skip _processed/ and other dirs\n    const m = f.path.match(/clone_drafts\\/([^/]+)\\//);\n    out.push({ json: {\n      brand: m ? m[1] : 'unknown',\n      filename: f.name,\n      download_url: f.download_url,\n      sha: f.sha,\n      path: f.path,\n    }});\n  }\n}\nreturn out;"
      },
      "id": "node-filter",
      "name": "Filter Unposted Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.download_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "raw"
            }
          }
        }
      },
      "id": "node-fetch-content",
      "name": "Fetch Draft Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Runs once PER ITEM so every draft is parsed (was $input.first() = 1 draft/hour).\n// FIX: read the raw text field. The old code did JSON.stringify() on the response\n// object, which escaped every newline and made the frontmatter regex never match.\nconst meta = $('Filter Unposted Files').item.json;\nconst raw = typeof $json.raw === 'string' ? $json.raw\n          : typeof $json.data === 'string' ? $json.data\n          : typeof $json.body === 'string' ? $json.body : '';\n\nconst bail = (reason, extra = {}) => ({ json: { skip: true, reason, filename: meta.filename, path: meta.path, ...extra } });\n\nif (!raw.trim()) return bail('empty or failed fetch');\n\nconst fm = raw.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---/);\nif (!fm) return bail('no frontmatter');\n\nconst get = (k) => {\n  const m = fm[1].match(new RegExp('^' + k + ':\\\\s*(.*)$', 'm'));\n  return m ? m[1].trim().replace(/^[\"']|[\"']$/g, '') : '';\n};\n\nconst platforms = get('platforms').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nif (!platforms.length) return bail('no platforms in frontmatter');\n\nconst kind = (get('kind') || 'social').toLowerCase();\nif (kind === 'video') return bail('kind: video belongs to the Video Pipeline');\n\nconst scheduled = get('scheduled') || get('date');\nconst rawTime = get('time');\nconst time = /^\\d{1,2}:\\d{2}$/.test(rawTime) ? rawTime.padStart(5, '0') : '12:00';\n\nif (scheduled) {\n  const at = new Date(`${scheduled}T${time}:00Z`);\n  if (isNaN(at.getTime())) return bail('unparseable scheduled date', { scheduled });\n  const diffMin = (at.getTime() - Date.now()) / 60000;\n  if (diffMin > 90) return bail('too early', { scheduled, time, diffMin: Math.round(diffMin) });\n  if (diffMin < -1440) return bail('too old', { scheduled, time, diffMin: Math.round(diffMin) });\n}\n\nconst body = raw.replace(/^---\\r?\\n[\\s\\S]*?\\r?\\n---\\r?\\n?/, '').trim();\nif (!body) return bail('empty body');\n\nreturn { json: {\n  brand: (get('brand') || meta.brand).toLowerCase(),\n  platforms, body, kind,\n  scheduled, time,\n  filename: meta.filename, path: meta.path, sha: meta.sha,\n  skip: false,\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "node-parse",
      "name": "Parse Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        300
