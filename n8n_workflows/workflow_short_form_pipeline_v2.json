        "jsCode": "// Fallback: unknown platform name, or brand credentials were missing.\nreturn { json: { status: 'unhandled', brand: $json.brand, filename: $json.filename,\n  platform: $json.platform,\n  requested: $json.platforms, reason: $json.credReason || `no route for platform: ${$json.platform}` }};",
