    {
      "parameters": {
        "jsCode": "// Build the .posted- marker. Paired-item lookup works from any success branch.\nconst d = $('Resolve Brand Credentials').item.json;\nconst ts = new Date().toISOString().slice(0, 10);\nconst newName = `${d.filename.replace(/\\.md$/i, '')}.posted-${ts}.md`;\nconst newPath = d.path.replace(/[^/]+$/, newName);\n\nconst marker = [\n  '---',\n  `posted_at: ${new Date().toISOString()}`,\n  `brand: ${d.brand}`,\n  `platforms: ${(d.platforms || []).join(', ')}`,\n  `posted_via: ${d.platform}`,\n  `original: ${d.filename}`,\n  '---',\n  '',\n  d.body || '',\n].join('\\n');\n\nreturn { json: {\n  old_path: d.path, new_path: newPath, sha: d.sha,\n  filename: d.filename, newName, brand: d.brand, platform: d.platform,\n  commit_message: `posted(${d.brand}/${d.platform}): ${d.filename}`,\n  content_b64: Buffer.from(marker, 'utf8').toString('base64'),\n}};",
        "mode": "runOnceForEachItem"
