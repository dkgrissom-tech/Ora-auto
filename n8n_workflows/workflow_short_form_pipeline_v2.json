    {
      "parameters": {
        "jsCode": "// Terminal branch: this platform needs an image. The draft is NOT marked posted,\n// so it retries hourly until the 'too old' window (24h) ages it out.\nconst d = $json;\nreturn { json: { status: 'skipped', platform: d.platform, brand: d.brand,\n  filename: d.filename,\n  reason: `${d.platform} requires media - add an 'image:' field to the draft frontmatter and an upload node` }};",
        "mode": "runOnceForEachItem"
      },
