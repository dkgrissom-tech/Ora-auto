    {
      "parameters": {
        "jsCode": "// Grapheme-safe truncation to Bluesky's 300 limit (substring() splits emoji).\nconst d = $('Resolve Brand Credentials').item.json;\nconst chars = Array.from(d.body || '');\nconst text = chars.length > 300 ? Array.from(chars.slice(0, 297)).join('') + '...' : chars.join('');\nreturn { json: { ...d, postText: text } };",
        "mode": "runOnceForEachItem"
      },
