        "url": "https://bsky.social/xrpc/com.atproto.server.createSession",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ identifier: $json.blueskyHandle, password: $json.blueskyPassword }) }}",
        "options": {}
