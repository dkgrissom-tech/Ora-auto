    {
      "parameters": {
        "jsCode": "// One item per platform, across ALL drafts (was $input.first()).\nconst out = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  for (const platform of (d.platforms || [])) out.push({ json: { ...d, platform } });\n}\nreturn out;"
      },
      "id": "node-split-platforms",
      "name": "Split by Platform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// FIX: the original hardcoded GRISSOM_* tokens for all four brands, which would\n// have posted Ora and Family Book drafts to the Grissom accounts. Resolve per brand\n// and refuse to post rather than post to the wrong account.\nconst V = (typeof $env !== 'undefined' && $env) ? $env : {};\nconst prefix = { ora: 'ORA', grissom: 'GRISSOM', familybook: 'FAMILYBOOK' }[$json.brand];\nconst out = { ...$json };\n\nif (!V.GITHUB_TOKEN) out.warnGithubToken = 'GITHUB_TOKEN variable is empty - GitHub calls are unauthenticated (60 req/hr)';\n\nif (!prefix) return { json: { ...out, platform: 'no_creds', credReason: `unknown brand: ${$json.brand}` } };\nout.prefix = prefix;\n\nconst need = {\n  bluesky:  { blueskyHandle: 'BLUESKY_HANDLE', blueskyPassword: 'BLUESKY_APP_PASSWORD' },\n  threads:  { threadsUserId: 'THREADS_USER_ID', metaToken: 'META_LONG_TOKEN' },\n  linkedin: { linkedinToken: 'LINKEDIN_TOKEN', linkedinPerson: 'LINKEDIN_PERSON_ID' },\n}[$json.platform];\n\nif (need) {\n  const missing = [];\n  for (const [field, varName] of Object.entries(need)) {\n    const val = V[`${prefix}_${varName}`];\n    out[field] = val ? String(val) : '';\n    if (!val) missing.push(`${prefix}_${varName}`);\n  }\n  if (missing.length) {\n    return { json: { ...out, platform: 'no_creds', credReason: `missing environment variables: ${missing.join(', ')}` } };\n  }\n}\n\nif (out.linkedinPerson) {\n  // FIX: checklist says LINKEDIN_PERSON_ID is already a full URN. The old node\n  // prepended the prefix unconditionally -> urn:li:person:urn:li:person:xxxx\n  out.linkedinUrn = out.linkedinPerson.startsWith('urn:li:person:')\n    ? out.linkedinPerson\n    : `urn:li:person:${out.linkedinPerson}`;\n}\nreturn { json: out };",
        "mode": "runOnceForEachItem"
      },
