              "value": "ora-auto-n8n"
            }
          ]
        },
        "options": {}
      },
      "id": "node-list-files",
      "name": "List Video Draft Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
