    {
      "parameters": {
        "jsCode": "// One request covers every platform for this draft, so a 3-platform draft is one\n// API call rather than three. Postiz caps create-post at 90 requests/hour.\nconst d = $('Match Brand Channels').item.json;\nconst media = $json || {};\nconst id = media.id ?? media._id ?? null;\nconst path = media.path ?? media.url ?? null;\n\nif (!id || !path) {\n  return { json: { ...d, skip: true, reason: 'Postiz upload returned no media id/path',\n                   upload_response: media } };\n}\n\nconst image = [{ id, path }];\nconst title = String(d.caption || '').slice(0, 100);\nconst content = String(d.caption || '').slice(0, 2200);\n\nconst settingsFor = (platform) => {\n  if (platform === 'youtube') return {\n    __type: 'youtube', title,\n    type: d.video_type === 'short' ? 'short' : 'public',\n    selfDeclaredMadeForKids: 'false', tags: [],\n  };\n  if (platform === 'tiktok') return {\n    __type: 'tiktok', privacy_level: 'PUBLIC_TO_EVERYONE',\n    duet: false, stitch: false, comment: true, autoAddMusic: 'no',\n    brand_content_toggle: 'no', brand_organic_toggle: 'no',\n    content_posting_method: 'DIRECT_POST',\n  };\n  if (platform === 'instagram') return { __type: 'instagram', post_type: 'reel' };\n  return { __type: platform };\n};\n\nconst payload = {\n  type: 'now',\n  date: new Date().toISOString(),\n  shortLink: false,\n  tags: [],\n  posts: d.channels.map((c) => ({\n    integration: { id: c.id },\n    value: [{ content, image }],\n    settings: settingsFor(c.platform),\n  })),\n};\n\nreturn { json: { ...d, media: image, postiz_payload: payload } };",
        "mode": "runOnceForEachItem"
      },
