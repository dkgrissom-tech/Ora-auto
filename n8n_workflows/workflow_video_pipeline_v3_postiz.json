    {
      "parameters": {
        "jsCode": "for (const i of $input.all()) {\n  const j = i.json;\n  console.log(`[video-render-fail] ${j.brand}/${j.filename} job=${j.job_id} ` +\n              `status=${j.poll_status} attempts=${j.attempt} timed_out=${j.timed_out}`);\n}\nreturn $input.all();"
      },
