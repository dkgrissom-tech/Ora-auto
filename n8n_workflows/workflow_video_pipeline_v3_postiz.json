    {
      "parameters": {
        "jsCode": "// Manual source: video_url must already be in the frontmatter.\nconst d = $json;\nif (!d.video_url) {\n  return { json: { ...d, skip: true, reason: 'video_source: manual but no video_url' } };\n}\nreturn { json: { ...d, job_id: null, final_video_url: d.video_url } };",
        "mode": "runOnceForEachItem"
      },
      "id": "node-manual",
      "name": "Manual Video URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "// FIX: v1 read $('Route by Video Source').first() and Enterprise-only variables.\n// This uses .item + $env, and carries the draft context forward so nothing downstream has to reach back\n// across a Wait node (item pairing does not survive a resumed execution).\nconst draft = $('Parse Video Draft').item.json;\nconst r = $json || {};\nconst job_id = r.job_id ?? r.id ?? r.jobId ?? r.job ?? null;\n\n// Railway variables reach Code nodes through $env (Community edition has no Variables).\nconst base = draft.video_source === 'yt-studio'\n  ? ($env.YT_STUDIO_API_URL || '')\n  : ($env.CIG_API_URL || '');\n\nif (!job_id) {\n  return { json: { ...draft, skip: true, reason: 'generator returned no job id',\n                   generator_response: r } };\n}\nif (!base) {\n  return { json: { ...draft, skip: true,\n                   reason: `missing Railway variable for ${draft.video_source} API URL` } };\n}\n\nreturn { json: { ...draft, job_id,\n                 poll_url: `${base.replace(/\\/$/, '')}/api/video/${job_id}`,\n                 source: draft.video_source, attempt: 0 } };",
        "mode": "runOnceForEachItem"
      },
      "id": "node-prep-poll",
      "name": "Prep Poll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
