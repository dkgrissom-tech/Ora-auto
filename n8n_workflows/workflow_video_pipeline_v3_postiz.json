      "id": "node-fetch",
      "name": "Fetch Video Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Runs once PER ITEM, so every draft is parsed (was $input.first() = 1/hour).\n// FIX: read the raw text field. The old code JSON.stringify()'d the response\n// object, escaping every newline so the frontmatter regex could never match.\nconst meta = $('Filter Unposted Video Drafts').item.json;\nconst raw = typeof $json.raw === 'string' ? $json.raw\n          : typeof $json.data === 'string' ? $json.data\n          : typeof $json.body === 'string' ? $json.body : '';\n\nconst base = { filename: meta.filename, path: meta.path, sha: meta.sha, brand: meta.brand };\nconst bail = (reason, extra = {}) => ({ json: { ...base, skip: true, reason, ...extra } });\n\nif (!raw.trim()) return bail('empty or failed fetch');\n\nconst fm = raw.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---/);\nif (!fm) return bail('no frontmatter');\n\nconst get = (k) => {\n  const m = fm[1].match(new RegExp('^' + k + ':\\\\s*(.*)$', 'm'));\n  return m ? m[1].trim().replace(/^[\"']|[\"']$/g, '') : '';\n};\n\nconst video_source = (get('video_source') || 'manual').toLowerCase();\nconst video_url = get('video_url');\nconst video_type = (get('video_type') || 'short').toLowerCase();\nconst platforms = get('platforms').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nconst caption = get('caption') || get('title') || '';\nconst brand = (get('brand') || meta.brand).toLowerCase();\n\nif (!platforms.length) return bail('no platforms in frontmatter');\nif (!caption.trim()) return bail('no caption/title in frontmatter');\n\n// FIX: default time was 23:00 UTC, which held every draft that omitted `time`\n// until nearly midnight. 12:00 matches the social pipeline's default.\nconst rawTime = get('time');\nconst time = /^\\d{1,2}:\\d{2}$/.test(rawTime) ? rawTime.padStart(5, '0') : '12:00';\nconst scheduled = get('scheduled') || get('date');\n\nif (scheduled) {\n  const at = new Date(`${scheduled}T${time}:00Z`);\n  if (isNaN(at.getTime())) return bail('unparseable scheduled date', { scheduled, time });\n  const diffMin = (at - new Date()) / 60000;\n  if (diffMin > 90) return bail('too early', { scheduled, time });\n  // FIX: v1 had no lower bound, so a draft dated last month posted immediately\n  // on the next tick. Anything more than 24h stale is stranded, not due.\n  if (diffMin < -1440) return bail('stale, more than 24h past due', { scheduled, time });\n}\n\nreturn { json: { ...base, brand, video_source, video_url, video_type, platforms,\n                 caption, raw, skip: false } };",
        "mode": "runOnceForEachItem"
      },
