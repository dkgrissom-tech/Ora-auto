    {
      "parameters": {
        "jsCode": "// FIX: iterate every input item. $input.first() silently dropped 2 of 3 brands.\n// FIX: derive brand from the file's own path instead of re-reading node output 0.\n// Tolerates a 404 folder ({message:'Not Found'}) instead of throwing.\nconst out = [];\nfor (const item of $input.all()) {\n  const p = item.json;\n  let files = [];\n  if (Array.isArray(p)) files = p;\n  else if (Array.isArray(p.data)) files = p.data;\n  else if (p && p.name) files = [p];\n  for (const f of files) {\n    if (!f || typeof f.name !== 'string' || !f.path) continue;\n    if (f.type && f.type !== 'file') continue;              // skip _processed/ etc\n    if (!f.name.toLowerCase().endsWith('.md')) continue;\n    if (f.name.includes('.posted-')) continue;              // already published\n    if (f.name.includes('.skip.')) continue;                // manually retired\n    if (f.name.toLowerCase() === 'readme.md') continue;\n    const m = f.path.match(/video_drafts\\/([^/]+)\\//);\n    out.push({ json: {\n      brand: m ? m[1] : 'unknown',\n      filename: f.name,\n      download_url: f.download_url,\n      sha: f.sha,\n      path: f.path,\n    }});\n  }\n}\nreturn out;"
      },
      "id": "node-filter",
      "name": "Filter Unposted Video Drafts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.download_url }}",
