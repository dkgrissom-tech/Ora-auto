    {
      "parameters": {
        "jsCode": "// FIX: v1 had no loop at all - Wait -> Poll -> Fan Out ran exactly once, so any\n// render slower than 30s published an unfinished (or missing) video URL.\n// This node classifies the poll and carries the context back around the loop.\nconst ctx = $('Prep Poll').item.json;\nconst r = $json || {};\nconst attempt = (ctx.attempt || 0) + $runIndex + 1;\n\nconst status = String(r.status ?? r.state ?? '').toLowerCase();\nconst url = r.video_url ?? r.url ?? r.output_url ?? r.download_url ?? (r.result && r.result.url) ?? null;\n\nconst failed = ['failed', 'error', 'cancelled', 'canceled'].includes(status);\nconst ready = !!url && (!status || ['done', 'ready', 'complete', 'completed', 'succeeded', 'success', 'finished'].includes(status));\n\nreturn { json: {\n  ...ctx,\n  attempt,\n  poll_status: status || 'unknown',\n  ready,\n  failed,\n  final_video_url: url,\n  // 30 polls x 30s = 15 min ceiling\n  timed_out: attempt >= 30,\n  poll_response: r,\n}};",
        "mode": "runOnceForEachItem"
      },
      "id": "node-eval-poll",
      "name": "Evaluate Poll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        130
      ]
    },
