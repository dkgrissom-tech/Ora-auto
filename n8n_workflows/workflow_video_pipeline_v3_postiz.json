    {
      "parameters": {
        "jsCode": "// FIX: 'grissomshop' is not a brand in dkgrissom-tech/Ora-auto.\n// brands/ and clone_drafts/ contain exactly: ora, grissom, familybook.\n// FIX: video drafts live in their own tree so the :50 ingest job and the :05\n// auto_post job (which own clone_drafts/) can never double-handle them.\nconst brands = ['ora', 'grissom', 'familybook'];\nreturn brands.map(brand => ({ json: { brand, path: `video_drafts/${brand}` } }));"
      },
      "id": "node-brands",
      "name": "List Brand Video Folders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        300
      ]
