    {
      "parameters": {
        "jsCode": "// Channel IDs are looked up at runtime, so none are hardcoded and nothing breaks\n// when a channel is reconnected. 'Postiz: List Channels' runs once per execution\n// before the brand fan-out, so .first() is correct here - it is one global list,\n// not per-item data.\nconst d = $json;\nconst resp = $('Postiz: List Channels').first().json;\nconst list = Array.isArray(resp) ? resp\n           : Array.isArray(resp.integrations) ? resp.integrations\n           : Array.isArray(resp.data) ? resp.data : [];\n\n// Optional explicit override, e.g.\n// POSTIZ_CHANNEL_MAP={\"ora\":{\"tiktok\":\"abc\",\"youtube\":\"def\"},\"grissom\":{...}}\nlet override = {};\ntry { override = JSON.parse($env.POSTIZ_CHANNEL_MAP || '{}'); } catch (e) {}\n\n// Brand -> the words that identify that brand's channel names in Postiz.\nconst brandWords = {\n  ora: ['ora'],\n  grissom: ['grissom', 'cedar hollow', 'dk grissom', 'd.k. grissom'],\n  familybook: ['family', 'familybook', 'family book'],\n};\n\nconst norm = (s) => String(s || '').toLowerCase();\nconst words = brandWords[d.brand] || [d.brand];\n\nconst matched = [];\nconst unmatched = [];\nfor (const platform of (d.platforms || [])) {\n  const fromOverride = override?.[d.brand]?.[platform];\n  if (fromOverride) { matched.push({ platform, id: fromOverride, name: '(override)' }); continue; }\n\n  const hits = list.filter((c) => {\n    const provider = norm(c.providerIdentifier || c.provider || c.identifier);\n    if (provider !== platform) return false;\n    if (c.disabled || c.refreshNeeded) return false;\n    const name = norm(c.name);\n    return words.some((w) => name.includes(w));\n  });\n\n  if (hits.length === 1) matched.push({ platform, id: hits[0].id, name: hits[0].name });\n  else if (hits.length > 1) unmatched.push(`${platform}: ${hits.length} channels match brand '${d.brand}' - set POSTIZ_CHANNEL_MAP to disambiguate`);\n  else unmatched.push(`${platform}: no enabled Postiz channel whose name matches brand '${d.brand}'`);\n}\n\nreturn { json: { ...d, channels: matched, channel_problems: unmatched,\n                 has_channels: matched.length > 0,\n                 reason: unmatched.join('; ') } };",
        "mode": "runOnceForEachItem"
      },
      "id": "node-match-channels",
      "name": "Match Brand Channels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
