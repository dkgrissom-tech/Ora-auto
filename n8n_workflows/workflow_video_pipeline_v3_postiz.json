        "url": "={{ $json.poll_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $json.source === 'yt-studio' ? ($env.YT_STUDIO_API_KEY || '') : ($env.CIG_API_KEY || '') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-poll",
      "name": "Poll Video Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2280,
        130
