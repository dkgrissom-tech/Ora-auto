      "name": "Wait 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2060,
        130
      ],
      "webhookId": "video-pipeline-poll-wait"
    },
    {
      "parameters": {
