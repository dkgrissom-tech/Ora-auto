# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgres://postgres:postgres@db.<ref>.supabase.co:5432/postgres

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_29=price_...
STRIPE_PRICE_79=price_...

# --- Queue (Upstash Redis) ---
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# --- S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=booktok-trailers
S3_PUBLIC_BASE_URL=https://booktok-trailers.s3.us-east-1.amazonaws.com

# --- Email ---
RESEND_API_KEY=re_...
RESEND_FROM="BookTok Trailer Factory <trailers@your-domain.com>"

# --- Higgsfield ---
# CLI is auth'd on the worker host via `higgsfield auth login`; no env var needed.
# Optional: pin a specific model if you want to override the CLI default:
HIGGSFIELD_VIDEO_MODEL=kling3_0

# --- Phase 2 (leave empty until 40+ paying users) ---
COMFYUI_ENDPOINT=
COMFYUI_LOCAL_FRACTION=0
